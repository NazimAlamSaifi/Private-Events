<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
  <h1>All Events</h1>
  <% if user_signed_in? %>
    <%= link_to "+ Create Event", new_event_path, class: "btn btn-primary" %>
  <% end %>
</div>

<h2 style="margin-bottom: 1rem;">Upcoming Events</h2>
<% if @upcoming_events.any? %>
  <% @upcoming_events.each do |event| %>
    <div class="event-card">
      <h2 class="event-title"><%= link_to event.title, event_path(event), style: "color: inherit; text-decoration: none;" %></h2>
      <p class="event-meta"><strong>Location:</strong> <%= event.location %></p>
      <p class="event-meta"><strong>Date:</strong> <%= event.date %></p> 
    </div>
  <% end %>
<% else %>
  <p class="event-meta" style="margin-bottom: 2rem;">No upcoming events scheduled.</p>
<% end %>

<h2 style="margin-top: 2rem; margin-bottom: 1rem;">Past Events</h2>
<% if @past_events.any? %>
  <% @past_events.each do |event| %>
    <div class="event-card" style="opacity: 0.6;">
      <h2 class="event-title"><%= link_to event.title, event_path(event), style: "color: inherit; text-decoration: none;" %></h2>
      <p class="event-meta"><strong>Location:</strong> <%= event.location %></p>
      <p class="event-meta"><strong>Date:</strong> <%= event.date %></p> 
    </div>
  <% end %>
<% end %>