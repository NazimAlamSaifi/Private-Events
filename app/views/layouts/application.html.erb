<!DOCTYPE html>
<html>
  <head>
    <title>Private Events</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags rescue nil %>
  </head>

  <body>
    <nav class="navbar">
      <%= link_to "EVENTHUB", root_path, class: "brand" %>
      
      <div class="nav-links">
        <%= link_to "All Events", root_path, class: "btn btn-outline" %>
        
        <% if user_signed_in? %>
          <%= link_to "Host Event", new_event_path, class: "btn btn-primary" %>
          <%= link_to "My Profile", user_path(current_user), class: "btn btn-outline" %>
          <%= button_to "Log Out", destroy_user_session_path, method: :delete, class: "btn btn-outline" %>
        <% else %>
          <%= link_to "Log In", new_user_session_path, class: "btn btn-outline" %>
          <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-primary" %>
        <% end %>
      </div>
    </nav>

    <main class="container">
      <% if notice %>
        <p style="color: #4ade80; margin-bottom: 1rem;"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p style="color: #f87171; margin-bottom: 1rem;"><%= alert %></p>
      <% end %>

      <%= yield %> 
    </main>
  </body>
</html>