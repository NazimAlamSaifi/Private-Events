<hr style="border-color: var(--border-color); margin: 3rem 0;">

<h2 style="margin-bottom: 1rem;">Upcoming Events</h2>

<% future_events = @user.attended_events.where("date >= ?", Time.now) %>

<% if future_events.any? %>
  <% future_events.each do |event| %>
    <div class="event-card">
      <h3 class="event-title">
        <%= link_to event.title, event_path(event), style: "color: inherit; text-decoration: none;" %>
      </h3>
      <p class="event-meta"><strong>Location:</strong> <%= event.location %></p>
      <p class="event-meta"><strong>Date:</strong> <%= event.date %></p>
    </div>
  <% end %>
<% else %>
  <p class="event-meta" style="margin-bottom: 2rem;">This user hasn't RSVP'd to any future events yet.</p>
<% end %>

<h2 style="margin-bottom: 1rem; margin-top: 2rem;">Past Events</h2>

<% past_events = @user.attended_events.where("date < ?", Time.now) %>

<% if past_events.any? %>
  <% past_events.each do |event| %>
    <div class="event-card" style="opacity: 0.6;"> 
      <h3 class="event-title">
        <%= link_to event.title, event_path(event), style: "color: inherit; text-decoration: none;" %>
      </h3>
      <p class="event-meta"><strong>Location:</strong> <%= event.location %></p>
      <p class="event-meta"><strong>Date:</strong> <%= event.date %></p>
    </div>
  <% end %>
<% else %>
  <p class="event-meta">This user hasn't attended any past events.</p>
<% end %>